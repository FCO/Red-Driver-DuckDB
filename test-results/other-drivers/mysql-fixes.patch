diff --git a/t/04-mysql.t b/t/04-mysql.t
index ec359ab..e04c0ab 100644
--- a/t/04-mysql.t
+++ b/t/04-mysql.t
@@ -40,6 +40,13 @@ is OnlySerial.^all.elems, 3, 'commit persists the transaction';
 
