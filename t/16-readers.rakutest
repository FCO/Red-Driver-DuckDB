use Test;
use Red;
use Red::Driver::DuckDB;
my $root = $*TMPDIR.add("red-readers-{$*PID}");
$root.mkdir;
LEAVE { .unlink for $root.dir; $root.rmdir }
my $csv = $root.add('people.csv');
$csv.spurt("id;nome;idade\n1;Ana;30\n2;Bruno;17\n2;Bruno;17\n");
my $db = Red::Driver::DuckDB.new;
my \Pessoa = $db.read-csv($csv.Str, :header, :delim<;>);
is Pessoa.^all.elems, 3, 'CSV row count without ambient driver';
my @source-names;
@source-names.push(.nome) for Pessoa.^all;
is-deeply @source-names, ['Ana', 'Bruno', 'Bruno'], 'source all iterates rows without slipping';
is Pessoa.^all.grep(*.idade >= 18).head.nome, 'Ana', 'filter and inflate';
is Pessoa.^all.map(*.idade).sum, 64, 'SQL aggregation';
is Pessoa.^all.sort(*.idade).head.nome, 'Bruno', 'SQL ordering';
is (Pessoa.^all X Pessoa.^all).grep({ .[0].id == .[1].id }).elems, 5, 'source self join';
is Pessoa.^source-columns<nome>, 'nome', 'source metadata';
dies-ok { Pessoa.^create(:nome<X>) }, 'view create rejected';
dies-ok { Pessoa.^all.delete }, 'view bulk delete rejected';
my $p = Pessoa.^all.head;
dies-ok { $p.^delete }, 'view instance delete rejected';
my \Copy = $db.read-csv($csv.Str, :header, :delim<;>, :materialize);
is Copy.^all.elems, 3, 'materialized count';
my @duplicate = Copy.^all.grep(*.nome eq 'Bruno').List;
ok @duplicate[0].red_row_id != @duplicate[1].red_row_id, 'duplicate rows have independent IDs';
my $created = Copy.^create(:id(4), :nome<Carla>, :idade(25));
ok $created.red_row_id.defined, 'new copy row receives ID';
$created.nome = 'Changed';
lives-ok { $created.^save }, 'save without ambient driver';
is Copy.^all.grep(*.id == 4).head.nome, 'Changed', 'update stored';
lives-ok { @duplicate[0].^delete }, 'individual delete';
is Copy.^all.grep(*.nome eq 'Bruno').elems, 1, 'delete selects only one duplicate';
is Pessoa.^all.elems, 3, 'original file unchanged';
my $json = $root.add('people.json');
$json.spurt('[{"name":"Olá","tags":[1,2],"info":{"active":true}},{"name":"Bye","tags":null,"info":null}]');
my \Json = $db.read-json($json.Str);
is Json.^all.head.name, 'Olá', 'JSON Unicode';
is-deeply Json.^all.head.tags, [1,2], 'nested array';
is-deeply Json.^all.head.info, {active => True}, 'nested struct';
ok !Json.^all.grep(*.name eq 'Bye').head.tags.defined, 'nested NULL';
my $text = $root.add('note.txt'); $text.spurt('hello 😀');
my \Text = $db.read-text($text.Str);
is Text.^all.head.content, 'hello 😀', 'text reader';
my \Binary = $db.read-blob($text.Str);
is-deeply Binary.^all.head.content, Blob.new('hello 😀'.encode.list), 'blob reader';
my $parquet = $root.add('people.parquet');
$db.execute("COPY (SELECT 1 AS id, 'Ana' AS nome) TO '{$parquet.Str}' (FORMAT PARQUET)");
my \Parquet = $db.read-parquet($parquet.Str);
is Parquet.^all.head.nome, 'Ana', 'Parquet reader';
for 'read-csv' => $csv, 'read-json' => $json, 'read-parquet' => $parquet,
    'read-text' => $text, 'read-blob' => $text -> $reader {
    my $method = $reader.key;
    my $name = "NamedSource_" ~ $method.subst('-', '_', :g);
    my \Named = $db."$method"($reader.value.Str, :$name);
    is Named.^name, $name, "$method accepts a model name";
    is Named.^table, "named_source_" ~ $method.subst('-', '_', :g), "$method uses the model name for its SQL view";
    ok Named.^all.head.defined, "$method named model queries rows";
}
my \NamedCopy = $db.read-csv($csv.Str, :name<NamedSource>, :materialize, :header, :delim<;>);
is NamedCopy.^name, 'NamedSource', 'materialized model accepts a name';
is NamedCopy.^all.elems, 3, 'named materialized model queries rows';
is NamedCopy.^table, 'named_source', 'materialized table uses the model name';
my \NamedAgain = $db.read-source('read_csv', $csv.Str, :name<NamedAgain>, :header, :delim<;>);
is NamedAgain.^name, 'NamedAgain', 'generic reader accepts a model name';
is NamedAgain.^table, 'named_again', 'generic reader names its SQL view';
dies-ok { $db.read-csv($csv.Str, :name<NamedAgain>, :header, :delim<;>) }, 'duplicate view name rejected';
is NamedAgain.^all.elems, 3, 'failed duplicate leaves existing view intact';
dies-ok { $db.read-csv($csv.Str, :name<NamedSource>, :materialize, :header, :delim<;>) }, 'duplicate materialized name rejected';
is NamedCopy.^all.elems, 3, 'failed duplicate leaves existing table intact';
lives-ok { NamedCopy.^create(:id(5), :nome<Extra>, :idade(20)) }, 'failed duplicate leaves existing sequence intact';
my \Quoted = $db.read-csv($csv.Str, :name('Quoted " Source'), :header, :delim<;>, :materialize);
is Quoted.^table, 'quoted " source', 'custom SQL name preserves quotes and spaces';
is Quoted.^all.elems, 3, 'quoted custom table name queries rows';
dies-ok { $db.read-csv($csv.Str, :name("Bad\0Name")) }, 'NUL model name rejected';
like Pessoa.^name, /^ 'DuckDBSource_red_source_' /, 'omitted model name retains generated name';
dies-ok { $db.read-csv($csv.Str, :name('')) }, 'empty model name rejected';
my $odd = $root.add('odd.csv'); $odd.spurt("a.b,a b,a_b,1x\n1,2,3,4\n");
my \Odd = $db.read-csv($odd.Str, :header);
is Odd.^source-columns<a_b>, 'a.b', 'normalized dotted column';
is Odd.^all.head.a_b, 1, 'normalized alias hydrates';
is Odd.^all.head.a_b_2, 2, 'normalized collision';
my $second = Red::Driver::DuckDB.new;
my \Other = $second.read-csv($csv.Str, :header, :delim<;>);
$second.close;
dies-ok { Other.^all.head }, 'closed source connection errors';
is Pessoa.^all.elems, 3, 'other driver unaffected';
dies-ok { $db.read-csv($root.add('missing.csv').Str) }, 'missing source errors';
dies-ok { $db.read-csv($csv.Str, |{'header); DROP TABLE x;--' => True}) }, 'option name injection rejected';
lives-ok { Copy.^all.grep(*.id == 4).map({ .idade = 31 }).save.List }, 'bulk save';
is Copy.^all.grep(*.id == 4).head.idade, 31, 'bulk update stored';
dies-ok { Pessoa.^all.map({ .idade = 50 }).save.List }, 'mapped view update rejected';
my \NestedCopy = $db.read-json($json.Str, :materialize);
my $nested = NestedCopy.^all.head;
$nested.tags.push(3);
dies-ok { $nested.^save }, 'in-place compound writes rejected';
dies-ok { Copy.^create(:red_row_id($created.red_row_id), :id(10), :nome<X>, :idade(1)) }, 'physical primary key rejects duplicates';
my $collision = $root.add('collision.csv');
$collision.spurt("red_row_id,nome\n9,Ana\n");
my \Collision = $db.read-csv($collision.Str, :header, :materialize);
is Collision.^all.head.red_row_id, 9, 'source key preserved';
ok Collision.^all.head.red_row_id_2.defined, 'synthetic key avoids collision';
my $late = $db.read-csv($csv.Str, :header, :delim<;>);
$csv.spurt("id;nome;idade\n1;New;40\n");
is $late.^all.head.nome, 'New', 'view reads changed file';
is Copy.^all.grep(*.id == 1).head.nome, 'Ana', 'copy independent of changed source';
$db.begin;
{ my $*RED-TRANSACTION-RUNNING = True; Copy.^create(:id(999), :nome<Rollback>, :idade(1)) }
$db.rollback;
is Copy.^all.grep(*.id == 999).elems, 0, 'copy insert rolls back';
my $map-file = $root.add('map.parquet');
$db.execute("COPY (SELECT struct_pack(m := MAP([1], [42])) AS info) TO '{$map-file.Str}' (FORMAT PARQUET)");
dies-ok { $db.read-parquet($map-file.Str) }, 'nested nontext MAP keys rejected';
done-testing;
