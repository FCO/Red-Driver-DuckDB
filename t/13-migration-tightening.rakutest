use Test;
use Red;
my $db = database 'DuckDB';
$db.execute('CREATE SEQUENCE tightening_ids');
$db.execute(q[CREATE TABLE tightening (id BIGINT PRIMARY KEY DEFAULT nextval('tightening_ids'), value VARCHAR, score BIGINT CHECK(score >= 0), code VARCHAR UNIQUE)]);
$db.execute('CREATE INDEX tightening_value ON tightening(value)');
$db.execute(q[COMMENT ON TABLE tightening IS 'table comment']);
$db.execute(q[COMMENT ON COLUMN tightening.value IS 'column comment']);
$db.execute(q[INSERT INTO tightening(value, score, code) VALUES(NULL, 1, 'one')]);
dies-ok { $db.migration-set-not-null('tightening', 'value') }, 'reconstruction requires a transaction';
$db.execute('BEGIN');
$db.execute(q[UPDATE tightening SET value='filled']);
lives-ok { $db.migration-set-not-null('tightening', 'value') }, 'tightens after update in same transaction';
$db.execute('ROLLBACK');
ok !$db.execute('SELECT value FROM tightening').row<value>.defined, 'rollback restores original data';
ok $db.schema-reader.table-definition('tightening').columns.first(*.name eq 'value').nullable,
    'rollback restores original nullability';
$db.execute('BEGIN');
$db.execute(q[UPDATE tightening SET value='filled']);
$db.migration-set-not-null('tightening', 'value');
$db.execute('COMMIT');
is $db.execute('SELECT value FROM tightening').row<value>, 'filled', 'commit preserves filled data';
dies-ok { $db.execute(q[INSERT INTO tightening(value, score, code) VALUES(NULL, 1, 'two')]) }, 'NOT NULL enforced';
dies-ok { $db.execute(q[INSERT INTO tightening(value, score, code) VALUES('x', -1, 'two')]) }, 'CHECK preserved';
dies-ok { $db.execute(q[INSERT INTO tightening(value, score, code) VALUES('x', 1, 'one')]) }, 'UNIQUE preserved';
dies-ok { $db.execute(q[INSERT INTO tightening(id, value, score, code) VALUES(1, 'x', 1, 'two')]) }, 'primary key preserved';
$db.execute(q[INSERT INTO tightening(value, score, code) VALUES('next', 1, 'two')]);
ok $db.execute(q[SELECT id FROM tightening WHERE code='two']).row<id> > 1, 'sequence default preserved';
ok $db.indexes-for-table('tightening').first(*.<name> eq 'tightening_value').defined, 'index preserved';
is $db.execute(q[SELECT comment FROM duckdb_tables() WHERE table_name='tightening']).row<comment>, 'table comment', 'table comment preserved';
is $db.execute(q[SELECT comment FROM duckdb_columns() WHERE table_name='tightening' AND column_name='value']).row<comment>, 'column comment', 'column comment preserved';
$db.close;
$db.dbh.close;
done-testing;
